page {
  min-height: 100%;
  color: #17231f;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(circle at 85% 3%, rgba(219, 255, 115, 0.24), transparent 360rpx),
    #f3f0e9;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 38rpx 28rpx 56rpx;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 750;
  line-height: 1.08;
  letter-spacing: -3rpx;
}

.page-subtitle {
  display: block;
  margin-top: 16rpx;
  color: #747e79;
  font-size: 23rpx;
  line-height: 1.7;
}

.eyebrow {
  color: #7d8782;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  background: #17231f;
  border-radius: 24rpx;
}

.accent-button {
  color: #16261f;
  background: #dbff73;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #dedad1;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 42rpx rgba(29, 42, 35, 0.05);
}

.skill-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 30rpx;
  color: #7d8782;
  text-align: center;
  background: rgba(255, 253, 248, 0.6);
  border: 2rpx dashed #d3cfc5;
  border-radius: 28rpx;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 24rpx;
  color: #14241d;
  font-size: 38rpx;
  background: #dbff73;
  border-radius: 24rpx;
}

.empty-title {
  color: #34463d;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.65;
}

.dialog-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: rgba(9, 22, 18, 0.55);
}

.dialog {
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 30rpx 40rpx;
  overflow-y: auto;
  background: #fffdf8;
  border-radius: 34rpx;
}

.dialog-title {
  display: block;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -2rpx;
}

.field {
  display: block;
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #5f6a65;
  font-size: 21rpx;
  font-weight: 650;
}

.field-input,
.field-picker {
  width: 100%;
  min-height: 78rpx;
  padding: 20rpx 22rpx;
  color: #17231f;
  font-size: 24rpx;
  background: #f6f3ec;
  border: 1rpx solid #dedad1;
  border-radius: 18rpx;
}

.field-area {
  width: 100%;
  min-height: 130rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  background: #f6f3ec;
  border: 1rpx solid #dedad1;
  border-radius: 18rpx;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.dialog-actions button {
  flex: 1;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #647069;
  font-size: 25rpx;
  font-weight: 650;
  background: #f2efe8;
  border-radius: 24rpx;
}

.error-text {
  display: block;
  padding: 18rpx 20rpx;
  margin-top: 20rpx;
  color: #9a3d2a;
  font-size: 21rpx;
  line-height: 1.55;
  background: #fff0eb;
  border-radius: 16rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: #77817c;
  font-size: 23rpx;
}

