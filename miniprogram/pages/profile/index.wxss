.profile-page {
  min-height: 100vh;
  background: #f3f0e9;
}

.profile-hero {
  display: flex;
  flex-direction: column;
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx 90rpx;
  color: white;
  background:
    radial-gradient(circle at 82% 12%, rgba(219, 255, 115, 0.18), transparent 320rpx),
    linear-gradient(155deg, #173129, #0d201a);
  border-radius: 0 0 40rpx 40rpx;
}

.profile-kicker {
  color: #dbff73;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.profile-title {
  margin-top: 26rpx;
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: -2rpx;
}

.profile-hint {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
}

.profile-card {
  margin: -50rpx 32rpx 0;
  padding: 40rpx 36rpx 48rpx;
  background: #fffdf8;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(16, 35, 30, 0.08);
}

.field-label {
  color: #7d8782;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.nickname-input {
  display: block;
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  color: #10231e;
  font-size: 28rpx;
  line-height: 92rpx;
  background: #f6f3ec;
  border: 1rpx solid #dedad1;
  border-radius: 18rpx;
}

.error-text {
  display: block;
  margin-top: 16rpx;
  color: #b4462f;
  font-size: 24rpx;
}

.save-button {
  width: 100% !important;
  margin: 40rpx 0 0 !important;
  padding: 26rpx;
  color: #10231e;
  font-size: 28rpx;
  font-weight: 750;
  background: #dbff73;
  border-radius: 20rpx;
}

.skip-button {
  width: 100% !important;
  margin: 18rpx 0 0 !important;
  padding: 22rpx;
  color: #7d8782;
  font-size: 26rpx;
  background: transparent;
}

.save-button::after,
.skip-button::after {
  border: none;
}
