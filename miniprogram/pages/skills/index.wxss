.add-skill {
  margin-top: 30rpx;
}

.summary-strip {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 0;
  margin: 28rpx 0 20rpx;
  border-top: 1rpx solid #d8d4ca;
  border-bottom: 1rpx solid #d8d4ca;
}

.summary-strip view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #848d88;
  font-size: 17rpx;
}

.summary-value {
  color: #17231f;
  font-size: 27rpx;
  font-weight: 720;
}

.skill-empty {
  margin-top: 50rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.skill-card {
  padding: 28rpx;
  border-top: 7rpx solid #dbff73;
}

.skill-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skill-heading {
  display: flex;
  gap: 12rpx;
  align-items: center;
  font-size: 35rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.skill-actions {
  display: flex;
  gap: 4rpx;
}

.skill-actions button {
  padding: 8rpx 9rpx;
  color: #78827d;
  font-size: 16rpx;
  background: #f2efe8;
  border-radius: 10rpx;
}

.paused-label {
  padding: 4rpx 8rpx;
  color: #8a7254;
  font-size: 15rpx;
  background: #fff2dc;
  border-radius: 8rpx;
}

.skill-description {
  display: block;
  margin-top: 12rpx;
  color: #7d8681;
  font-size: 20rpx;
  line-height: 1.65;
}

.progress-line {
  height: 9rpx;
  margin-top: 24rpx;
  overflow: hidden;
  background: #e9e6de;
  border-radius: 8rpx;
}

.progress-line view {
  height: 100%;
  border-radius: inherit;
}

.skill-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 18rpx;
  color: #8b938f;
  font-size: 17rpx;
}

.generate-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70rpx;
  padding: 0 20rpx;
  margin-top: 22rpx;
  color: #31433a;
  font-size: 20rpx;
  font-weight: 700;
  background: #f2efe8;
  border-radius: 17rpx;
}

.accent-list {
  display: flex;
  gap: 18rpx;
}

.accent-list button {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid #fffdf8;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx #d4d0c7;
}

.accent-list button.selected {
  box-shadow: 0 0 0 4rpx #263a31;
}
